# Google Gemini (clip review + first coach model)
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional free coach fallbacks if Gemini is rate-limited / empty
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free

# HenrikDev unofficial VALORANT API (required for match JSON)
# Free key: join https://discord.com/invite/X3GaVkX2YN then #get-a-key
HENRIK_DEV_API_KEY=
HENRIK_MAX_RPM=30
GEMINI_MODEL=gemini-3.6-flash
# Optional comma-separated fallbacks if the preferred model is rate-limited
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite

# Your Riot ID — send these next so we can fetch YOUR data only
RIOT_NAME=
RIOT_TAG=
# Platform shard: eu | na | ap | kr | latam | br
RIOT_REGION=eu
